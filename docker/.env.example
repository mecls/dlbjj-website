# ============================================================================
#  docker/.env — a VPS. Copiar para docker/.env e preencher.
#  Os valores abaixo são de EXEMPLO (servem para `docker compose config`).
# ============================================================================

# ── Supabase (projeto dedicado da DL-BJJ; a service role) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=exemplo-service-role-key

# ── A app na Vercel ──
APP_BASE_URL=https://www.dlbjj.org
# Igual a DLBJJ_WORKER_TOKEN na Vercel. openssl rand -hex 32
DLBJJ_WORKER_TOKEN=exemplo-token-do-worker-32-hex

# ── Gateway OpenWA ──
# openssl rand -hex 32
OPENWA_API_KEY=exemplo-api-key-do-gateway-32-hex
# O UUID que POST /api/sessions devolve (README §3)
OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
# openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=exemplo-segredo-do-webhook-32-hex
# Porta publicada em loopback (a ARwatches usa 2785)
OPENWA_PORT=2786
OPENWA_LOG_LEVEL=info

# ── Worker ──
WORKER_ID=dlbjj-worker-1
WORKER_REGISTER_WEBHOOK=true
WORKER_DRAIN_INTERVAL_MS=15000
WORKER_HEARTBEAT_INTERVAL_MS=60000
WORKER_HUMANIZE=1
WORKER_LOG_LEVEL=info
