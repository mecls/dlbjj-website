# ============================================================================
#  Worker DL-BJJ — variáveis (docker/.env na VPS, ou worker/.env.local em dev)
# ============================================================================

# ── Base de dados (o MESMO projeto Supabase da app; service role) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── A app na Vercel ──
APP_BASE_URL=https://www.dlbjj.org
# Igual a DLBJJ_WORKER_TOKEN na Vercel (cabeçalho x-dlbjj-token)
DLBJJ_WORKER_TOKEN=

# ── Gateway OpenWA (rmyndharis/OpenWA, motor Baileys) ──
# Dentro do compose é http://openwa-api:2785; em dev http://127.0.0.1:2786
OPENWA_BASE_URL=http://openwa-api:2785
# Cabeçalho X-API-Key (= API_MASTER_KEY do gateway). openssl rand -hex 32
OPENWA_API_KEY=
# O UUID que POST /api/sessions devolveu — não o nome da sessão
OPENWA_SESSION_ID=
# Segredo HMAC com que o gateway assina as entregas. openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=

# ── O próprio worker ──
WORKER_PORT=4001
WORKER_WEBHOOK_PATH=/webhooks/openwa
# Como o gateway chega ao worker (dentro do compose: http://dlbjj-worker:4001)
WORKER_PUBLIC_URL=http://dlbjj-worker:4001
WORKER_ID=dlbjj-worker-1
WORKER_REGISTER_WEBHOOK=true
WORKER_DRAIN_INTERVAL_MS=15000
WORKER_HEARTBEAT_INTERVAL_MS=60000
# 0 só em testes: sem indicador de escrita nem atrasos
WORKER_HUMANIZE=1
LOG_LEVEL=info
