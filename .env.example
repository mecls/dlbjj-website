# ============================================================================
#  Agente de WhatsApp (DL-BJJ) — variáveis de ambiente da APP (Vercel / .env.local)
# ----------------------------------------------------------------------------
#  Copia para .env.local e preenche. A app nunca fala com o WhatsApp: escreve
#  na fila de saída e o worker (ver worker/ e docker/) envia. Para desenvolver
#  sem rede, OLLAMA_FAKE=1 e as rotas /api/sim/* injetam mensagens no motor.
# ============================================================================

# ── Supabase — projeto DEDICADO da DL-BJJ ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Ollama Cloud (endpoint compatível OpenAI) ──
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
#  1 = usar lib/llm/fake.ts em vez do modelo (testes / dev sem rede)
OLLAMA_FAKE=

# ── A própria app ──
#  Base dos links públicos (/inscricao/…, /aluno/…). Em produção: https://www.dlbjj.org
APP_BASE_URL=http://localhost:3000
#  Segredo partilhado com o worker (cabeçalho x-dlbjj-token). openssl rand -hex 32
DLBJJ_WORKER_TOKEN=
#  Bearer dos crons da Vercel e x-sim-secret do simulador em produção. openssl rand -hex 32
CRON_SECRET=

# ── Dashboard /painel — password partilhada ──
#  Vazio: painel aberto em desenvolvimento, FECHADO em produção.
DASHBOARD_PASSWORD=
