# ============================================================================
#  Agente de WhatsApp (onboarding) — variáveis de ambiente
# ----------------------------------------------------------------------------
#  Copia para .env.local e preenche. Sem WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID
#  o motor usa o SIMULADOR automaticamente (dá para desenvolver sem a Meta).
# ============================================================================

# ── WhatsApp Cloud API — número da academia 351925797266 (Coexistence) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Ollama Cloud (endpoint compatível OpenAI) ──
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# ── Supabase — MESMO projeto da waldi (tabelas com prefixo dlbjj_) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dashboard /painel — password partilhada ──
#  Vazio: painel aberto em desenvolvimento, FECHADO em produção.
DASHBOARD_PASSWORD=

# ── Segredo para as rotas /api/sim/* (opcional) ──
#  Sem isto, o simulador só funciona em desenvolvimento e só enquanto os
#  WHATSAPP_* estiverem vazios. Definir para o poder usar em produção, mandando
#  o cabeçalho:  -H "x-sim-secret: <valor>"
CRON_SECRET=
